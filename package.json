{
  "name": "frontline-summoners",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @frontline/client",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "assets:production:materialize:first-slice": "node tools/materialize-first-slice-production-art.mjs && node tools/polish-first-slice-unit-silhouettes.mjs && node tools/polish-first-slice-unit-motion-language.mjs && node tools/materialize-first-slice-boss.mjs && node tools/materialize-first-slice-production-audio.mjs",
    "assets:production:preflight:first-slice": "node tools/materialize-first-slice-review-preflight.mjs && node tools/materialize-first-slice-review-provenance.mjs && node tools/publish-first-slice-review-preflight.mjs",
    "assets:production:runtime:first-slice:check": "npm run assets:production:materialize:first-slice && npm run assets:production:preflight:first-slice && node tools/validate-first-slice-runtime-files.mjs",
    "assets:production:materialize:second-slice": "node tools/prepare-second-slice-source-cache.mjs && node tools/materialize-second-slice-production-art.mjs",
    "assets:production:runtime:second-slice:check": "npm run assets:production:materialize:second-slice && node tools/validate-second-slice-runtime-files.mjs",
    "assets:production:materialize:third-slice": "node tools/materialize-third-slice-production-art.mjs && node tools/assemble-third-slice-horizontal-strips.mjs && node tools/materialize-third-slice-battlefields.mjs",
    "assets:production:runtime:third-slice:check": "npm run assets:production:materialize:third-slice && node tools/validate-third-slice-runtime-files.mjs",
    "assets:production:materialize:fourth-slice": "node tools/materialize-fourth-slice-production-art.mjs && node tools/materialize-fourth-slice-battlefield.mjs",
    "assets:production:runtime:fourth-slice:check": "npm run assets:production:materialize:fourth-slice && node tools/validate-fourth-slice-runtime-files.mjs",
    "assets:production:materialize:fifth-slice": "node tools/materialize-fifth-slice-production-art.mjs",
    "assets:production:runtime:fifth-slice:check": "npm run assets:production:materialize:fifth-slice && node tools/validate-fifth-slice-runtime-files.mjs",
    "assets:production:materialize:sixth-slice": "node tools/materialize-sixth-slice-production-art.mjs",
    "assets:production:runtime:sixth-slice:check": "npm run assets:production:materialize:sixth-slice && node tools/validate-sixth-slice-runtime-files.mjs",
    "assets:production:materialize:chapter-02": "node tools/materialize-chapter-02-production-art.mjs",
    "assets:production:runtime:chapter-02:check": "npm run assets:production:materialize:chapter-02 && node tools/validate-chapter-02-runtime-files.mjs",
    "assets:production:materialize:chapter-03": "node tools/materialize-chapter-03-production-art.mjs",
    "assets:production:runtime:chapter-03:check": "npm run assets:production:materialize:chapter-03 && node tools/validate-chapter-03-runtime-files.mjs",
    "assets:production:materialize:chapter-04": "node tools/materialize-chapter-04-production-art.mjs",
    "assets:production:runtime:chapter-04:check": "npm run assets:production:materialize:chapter-04 && node tools/validate-chapter-04-runtime-files.mjs",
    "assets:production:materialize:special-content": "node tools/materialize-special-content-production-art.mjs",
    "assets:production:runtime:special-content:check": "npm run assets:production:materialize:special-content && node tools/validate-special-content-runtime-files.mjs",
    "assets:production:materialize:recruitment": "node tools/materialize-recruitment-production-art.mjs && node tools/materialize-recruitment-form-production-art.mjs",
    "assets:production:runtime:recruitment:check": "npm run assets:production:materialize:recruitment && node tools/validate-recruitment-runtime-files.mjs && node tools/validate-recruitment-form-runtime-files.mjs",
    "assets:production:intake:check": "node tools/validate-production-vertical-slice.mjs",
    "assets:production:review:check": "node tools/validate-production-review-package.mjs",
    "assets:production:concept:check": "node tools/validate-production-concept-candidates.mjs",
    "assets:production:rework:check": "node tools/validate-production-rework-plan.mjs",
    "assets:production:check": "npm run assets:production:runtime:first-slice:check && npm run assets:production:runtime:second-slice:check && npm run assets:production:runtime:third-slice:check && npm run assets:production:runtime:fourth-slice:check && npm run assets:production:runtime:fifth-slice:check && npm run assets:production:runtime:sixth-slice:check && npm run assets:production:runtime:chapter-02:check && npm run assets:production:runtime:chapter-03:check && npm run assets:production:runtime:chapter-04:check && npm run assets:production:runtime:special-content:check && npm run assets:production:runtime:recruitment:check && npm run assets:production:intake:check && npm run assets:production:review:check && npm run assets:production:concept:check && npm run assets:production:rework:check"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
