{
  "name": "frontline-summoners",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @frontline/client",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "assets:production:materialize:non-character": "node tools/materialize-first-slice-production-audio.mjs && node tools/materialize-third-slice-battlefields.mjs && node tools/materialize-fourth-slice-battlefield.mjs",
    "assets:production:character-placeholder:check": "node tools/validate-placeholder-character-art-quarantine.mjs",
    "assets:production:rework-intake:import": "node tools/import-local-production-rework-draft.mjs",
    "assets:production:rework-intake:check": "node tools/validate-production-rework-intake-contract.mjs",
    "assets:production:intake:check": "node tools/validate-production-vertical-slice.mjs",
    "assets:production:review:check": "node tools/validate-production-review-package.mjs",
    "assets:production:concept:check": "node tools/validate-production-concept-candidates.mjs",
    "assets:production:rework:check": "node tools/validate-production-rework-plan.mjs",
    "assets:production:check": "npm run assets:production:character-placeholder:check && npm run assets:production:materialize:non-character && npm run assets:production:rework-intake:check && npm run assets:production:intake:check && npm run assets:production:review:check && npm run assets:production:concept:check && npm run assets:production:rework:check"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
