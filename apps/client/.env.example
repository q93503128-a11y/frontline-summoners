# Public client build setting for a separately hosted live-service API.
# Example: https://frontline-summoners-api.<your-workers-subdomain>.workers.dev
# Leave blank when the API is reverse-proxied on the same origin as the game client.
VITE_FRONTLINE_API_ORIGIN=

# A deployment may alternatively assign window.__FRONTLINE_API_ORIGIN__ before the game bundle loads.
# The runtime value is useful for static hosting when the API hostname must be changed without rebuilding.
